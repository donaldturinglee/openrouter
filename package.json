{
  "name": "openrouter",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@openrouter/backend",
    "dev:web": "turbo run dev --filter=@openrouter/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "prettier": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "format": "npm run lint:fix && npm run prettier:fix"
  },
  "devDependencies": {
    "prettier": "^3.10.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.11"
  }
}
